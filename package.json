{
  "name": "homecare-platform",
  "private": true,
  "description": "Home-care visit platform: patients book visits, clinicians clock in/out with GPS verification, admins see everything.",
  "scripts": {
    "db:push": "supabase db push --remote",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "smoke": "node --env-file=.env scripts/smoke-test.mjs",
    "seed:local": "node --env-file=.env.local scripts/seed.mjs",
    "smoke:local": "node --env-file=.env.local scripts/smoke-test.mjs",
    "mobile": "npm --prefix mobile start",
    "web": "npm --prefix web run dev"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "supabase": "^3.0.0"
  }
}
