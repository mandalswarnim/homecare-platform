# Copy to .env (git-ignored). Used by scripts/seed.mjs and scripts/smoke-test.mjs.
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (sb_publishable_…) or legacy anon key — safe to ship in apps
SUPABASE_ANON_KEY=
# Secret (sb_secret_…) or legacy service_role key — bypasses RLS, keep it on your machine only
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Password given to every seeded demo account
DEMO_PASSWORD=
